{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApprovalPacket",
  "description": "Front matter of approvals/<state>/<id>.md, as a fenced json block. Required set is the T0 proposal document; execution fields become required when the hands runner exists.",
  "type": "object",
  "required": ["id", "schema_version", "department", "tier", "action_class", "status", "mode", "created", "expires",
               "marketplace", "currency", "estimated_cost", "evidence", "impact", "if_ignored",
               "metric", "expected", "review_on", "design", "rule_refs"],
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9]{8}-(ceo|finance|supply-chain|advertising|catalog|pricing-intel|customer|account-health|expansion)-[a-z_]+-(ca|us)-[A-Za-z0-9-]+$"},
    "schema_version": {"const": "1.0"},
    "department": {"enum": ["ceo", "finance", "supply-chain", "advertising", "catalog", "pricing-intel", "customer", "account-health", "expansion"]},
    "tier": {"enum": ["T2", "T3"]},
    "action_class": {"enum": ["purchase_order", "pricing_band_change", "price_change", "listing_change", "fba_shipment", "campaign_create",
                              "ad_bid_change", "ad_budget_change", "negative_keyword", "coupon", "deal", "buyer_message", "request_a_review",
                              "vine_enrolment", "reimbursement_claim", "qbo_bill", "strategy"]},
    "status": {"enum": ["pending", "approved", "rejected", "expired", "withdrawn", "executing", "executed", "partial", "failed", "superseded"]},
    "mode": {"enum": ["dry-run", "execute"], "description": "dry-run until a hands runner with a write path exists; the runner refuses execute unless the class is T1/T2-enabled in department.yaml"},
    "created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?[+-][0-9]{2}:[0-9]{2}$"},
    "expires": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?[+-][0-9]{2}:[0-9]{2}$"},
    "marketplace": {"enum": ["ca", "us"]},
    "currency": {"enum": ["CAD", "USD"]},
    "estimated_cost": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$", "description": "decimal string in currency; 0.00 when no money moves"},
    "fx": {"type": ["object", "null"], "properties": {"rate": {"type": "string"}, "base": {"type": "string"}, "quote": {"type": "string"}, "as_of": {"type": "string"}, "source": {"type": "string"}}},
    "skus": {"type": "array", "items": {"type": "string"}},
    "asins": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "state-file lines, export ids, ledger seqs"},
    "impact": {"type": "string"},
    "if_ignored": {"type": "string"},
    "goal_id": {"type": ["string", "null"]},
    "metric": {"type": "string"},
    "scope": {"type": "string"},
    "baseline": {"type": ["string", "number", "null"]},
    "expected": {"type": "string"},
    "measure_window": {"type": "string", "default": "14d_after_execution"},
    "review_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "design": {"enum": ["ab", "prepost-matched", "prepost", "none"]},
    "control_set": {"type": "array", "items": {"type": "string"}},
    "rule_refs": {"type": "array", "items": {"type": "string"}, "description": "pattern or skill ids that produced this proposal; empty array allowed"},
    "payload": {"type": "object"},
    "preconditions": {"type": "array", "items": {"type": "object", "required": ["check", "source", "observed", "asserted_at"], "properties": {"check": {"type": "string"}, "source": {"type": "string"}, "observed": {}, "asserted_at": {"type": "string"}, "revalidate": {"type": "boolean", "default": true}}}},
    "guardrails": {"type": "object"},
    "dry_run": {"type": ["object", "null"], "properties": {"action_id": {"type": ["string", "null"]}, "ran_at": {"type": "string"}, "tool": {"type": "string"}, "diff": {"type": "array"}, "warnings": {"type": "array"}}},
    "locks": {"type": "array", "items": {"type": "string"}},
    "decided_by": {"type": ["string", "null"]},
    "decided_at": {"type": ["string", "null"]},
    "decision_channel": {"enum": ["monday", "file-edit", null]},
    "execute_by": {"type": ["string", "null"], "description": "decided_at + 12h + 6h for packets over CAD 5,000 or T3; runner aborts after it"},
    "executed_at": {"type": ["string", "null"]},
    "ledger_ref": {"type": ["integer", "null"]},
    "supersedes": {"type": ["string", "null"]},
    "monday_item_id": {"type": ["string", "null"]}
  }
}
