{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LedgerEntry",
  "description": "One line of ledger/actions.jsonl. Only hands/ledger.py appends. hash = SHA-256 over RFC 8785 canonical JSON of all fields except hash.",
  "type": "object",
  "required": ["seq", "ts", "schema_version", "department", "tier", "action_class", "runtime", "actor", "target", "input", "output",
               "approval_id", "reason", "prev_hash", "hash"],
  "properties": {
    "seq": {"type": "integer", "minimum": 1},
    "ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"},
    "schema_version": {"const": "1.0"},
    "department": {"enum": ["ceo", "finance", "supply-chain", "advertising", "catalog", "pricing-intel", "customer", "account-health", "expansion", "hands"]},
    "tier": {"enum": ["T1", "T2", "T3"]},
    "action_class": {"enum": ["purchase_order", "pricing_band_change", "price_change", "listing_change", "fba_shipment", "campaign_create",
                              "ad_bid_change", "ad_budget_change", "negative_keyword", "coupon", "deal", "buyer_message", "request_a_review",
                              "vine_enrolment", "reimbursement_claim", "qbo_bill", "strategy", "decision"]},
    "runtime": {"enum": ["claude-code", "codex", "hands-runner", "human"]},
    "actor": {"type": "string"},
    "marketplace": {"enum": ["ca", "us", null]},
    "currency": {"enum": ["CAD", "USD", null]},
    "amount": {"type": ["string", "null"], "pattern": "^-?[0-9]+\\.[0-9]{2}$"},
    "amount_pre_round": {"type": ["string", "null"]},
    "target": {"type": "object"},
    "input": {"type": "object"},
    "output": {"type": "object", "required": ["status"], "properties": {
      "status": {"enum": ["dry-run", "in-flight", "ok", "partial", "failed", "noop", "handoff", "decision"]},
      "api": {"type": ["string", "null"]}, "http_status": {"type": ["integer", "null"]}, "response_id": {"type": ["string", "null"]}, "error": {"type": ["string", "null"]}}},
    "verification": {"type": ["object", "null"], "required": ["method", "expected", "observed", "passed", "checked_at"]},
    "approval_id": {"type": ["string", "null"]},
    "decided_by": {"type": ["string", "null"]},
    "dry_run_action_id": {"type": ["string", "null"]},
    "attempt": {"type": "integer", "default": 1},
    "reason": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "goal_id": {"type": ["string", "null"]},
    "rule_refs": {"type": "array", "items": {"type": "string"}},
    "prev_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$|^GENESIS$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "git_anchor": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"output": {"properties": {"status": {"enum": ["ok", "partial"]}}}}},
     "then": {"properties": {"verification": {"type": "object"}}}}
  ]
}
